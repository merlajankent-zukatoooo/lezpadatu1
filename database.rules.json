{
  "rules": {
    ".read": false,
    ".write": false,
    "lezdatuCloud": {
      "staff": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      },
      "station": {
        ".read": "auth != null && (root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'admin' || root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'refiller' || root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'rider')",
        ".write": "(auth != null && (root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'admin' || root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'refiller' || root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'rider')) && newData.exists() && (data.exists() || (auth != null && root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'admin'))",
        ".validate": "newData.hasChildren(['revision','payload','updatedAt','updatedBy']) && ((!data.exists() && newData.child('revision').val() == 1) || (data.exists() && newData.child('revision').val() == data.child('revision').val() + 1))",
        "revision": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "payload": {
          ".validate": "newData.isString() && newData.val().length <= 8388608"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedBy": {
          ".validate": "newData.val() == auth.uid"
        },
        "$other": {
          ".validate": false
        }
      },
      "catalog": {
        ".read": true,
        ".write": "(auth != null && (root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'admin' || root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'refiller' || root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'rider')) && newData.exists()",
        ".validate": "newData.hasChildren(['revision','products','paymentSettings'])"
      },
      "inbox": {
        ".read": "auth != null && (root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'admin' || root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'refiller')",
        "$request": {
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().length > 0"
          },
          "contact": {
            ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().length > 0"
          },
          "address": {
            ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().length > 0"
          },
          "purok": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "barangay": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "landmark": {
            ".validate": "newData.isString() && newData.val().length <= 250"
          },
          "mapLat": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "mapLng": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "deliveryDate": {
            ".validate": "newData.isString() && newData.val().length <= 10 && newData.val().length > 0 && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
          },
          "gallonMode": {
            ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().length > 0 && (newData.val() == 'Borrowed Gallon' || newData.val() == 'Exchange Gallon')"
          },
          "paymentMethod": {
            ".validate": "newData.isString() && newData.val().length <= 10 && newData.val().length > 0 && (newData.val() == 'Cash' || newData.val() == 'GCash' || newData.val() == 'Bank')"
          },
          "paymentReference": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "paymentScreenshot": {
            ".validate": "newData.isString() && newData.val().length <= 500000"
          },
          "productId": {
            ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().length > 0"
          },
          "reference": {
            ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().length > 0"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val().length <= 128 && newData.val().length > 0 && newData.val() == auth.uid"
          },
          "quantity": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000 && newData.val() % 1 == 0"
          },
          "agreement": {
            ".validate": "newData.val() == true"
          },
          "paymentClaimed": {
            ".validate": "newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          },
          ".write": "((auth != null && (root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'admin' || root.child('lezdatuCloud/staff').child(auth.uid).child('role').val() == 'refiller')) && data.exists() && !newData.exists()) || (auth != null && auth.token.firebase.sign_in_provider == 'anonymous' && !data.exists() && newData.exists())",
          ".validate": "newData.hasChildren([\"name\", \"contact\", \"address\", \"purok\", \"barangay\", \"landmark\", \"mapLat\", \"mapLng\", \"deliveryDate\", \"gallonMode\", \"paymentMethod\", \"paymentReference\", \"paymentScreenshot\", \"productId\", \"reference\", \"uid\", \"quantity\", \"agreement\", \"paymentClaimed\", \"createdAt\"])"
        }
      }
    }
  }
}
